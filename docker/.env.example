# iTop CMDB 栈环境变量示例
#
# 用法：复制为同目录 .env 后填入真实值。.env 已被 .gitignore 排除，禁止提交。
#   cp docker/.env.example docker/.env && chmod 600 docker/.env
#
# 说明：docker-compose.yml 中的口令字段使用 ${VAR:?} 语法，缺失时会直接报错，
#       不会回退到任何默认口令。

# ── 数据库（itop-db 与 sync 共用；修改后需同步改 iTop conf 或重建空库） ──
ITOP_DB_ROOT_PASSWORD=
ITOP_DB_PASS=

# ── iTop 管理员账号（REST API / synchro 引擎） ──
ITOP_USER=admin
ITOP_ADMIN_PWD=
CMDB_ORG=ITOPS

# ── Zabbix 只读 API ──
ZBX_URL=
ZBX_TOKEN=

# ── 同步节奏 ──
# 同步间隔（秒）：生产 14400
SYNC_INTERVAL_SECONDS=14400
# 单次 synchro_exec HTTP 超时（秒）
SYNC_HTTP_TIMEOUT=600
